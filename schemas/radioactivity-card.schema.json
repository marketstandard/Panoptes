{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://panoptes.dev/schemas/radioactivity-card.schema.json",
  "title": "Panoptes Watermark Radioactivity Card",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "scheme",
    "mode",
    "tier",
    "teacher",
    "inheritance",
    "removal",
    "limitations",
    "artifact_sha256"
  ],
  "properties": {
    "schema": {"const": "panoptes-radioactivity-card-v1"},
    "scheme": {"type": "string"},
    "adapter_version": {"type": "string"},
    "created_utc": {"type": "string"},
    "mode": {"enum": ["synthetic", "model"]},
    "tier": {"enum": ["cpu", "gpu"]},
    "teacher_model": {"type": ["string", "null"]},
    "student_model": {"type": ["string", "null"]},
    "teacher": {"type": "object"},
    "inheritance": {"type": "object"},
    "removal": {"type": "object"},
    "knowledge_preservation": {"type": "object"},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
