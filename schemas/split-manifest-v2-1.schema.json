{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://panoptes.dev/schemas/split-manifest-v2-1.schema.json",
  "title": "Panoptes Split Manifest v2.1",
  "description": "Frozen train/development/calibration/test group assignments per cohort. Committed before training; the final-test lock hash gates any --finalize run.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "registered_utc", "protocol_ref", "seed", "cohorts", "artifact_sha256"],
  "properties": {
    "schema": {"const": "panoptes-split-manifest-v2-1"},
    "registered_utc": {"type": "string"},
    "protocol_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "artifact_sha256"],
      "properties": {
        "path": {"type": "string"},
        "artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "seed": {"type": "integer"},
    "cohorts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cohort_id", "group_unit", "partitions"],
        "properties": {
          "cohort_id": {"type": "string"},
          "group_unit": {"type": "string"},
          "partitions": {
            "type": "object",
            "additionalProperties": false,
            "required": ["train", "development", "calibration", "test"],
            "properties": {
              "train": {"$ref": "#/$defs/partition"},
              "development": {"$ref": "#/$defs/partition"},
              "calibration": {"$ref": "#/$defs/partition"},
              "test": {"$ref": "#/$defs/partition"}
            }
          },
          "notes": {"type": "string"}
        }
      }
    },
    "artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "$defs": {
    "partition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["n_groups", "n_rows", "groups_sha256"],
      "properties": {
        "n_groups": {"type": "integer", "minimum": 0},
        "n_rows": {"type": "integer", "minimum": 0},
        "groups_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "SHA-256 over the sorted, newline-joined group identifiers assigned to this partition. Group membership is committed without committing raw text."
        }
      }
    }
  }
}
