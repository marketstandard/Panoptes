{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://panoptes.dev/schemas/methodology-report.schema.json",
  "title": "Panoptes Methodology Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "created_utc", "seed", "cohorts", "artifact_sha256"],
  "properties": {
    "schema": {"const": "panoptes-methodology-v1"},
    "created_utc": {"type": "string"},
    "seed": {"type": "integer"},
    "cohorts": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/cohort"}
    },
    "artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "$defs": {
    "cohort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["n_records", "n_human", "n_ai", "families", "note", "feature_screening", "model", "specification", "hypotheses"],
      "properties": {
        "n_records": {"type": "integer", "minimum": 0},
        "n_human": {"type": "integer", "minimum": 0},
        "n_ai": {"type": "integer", "minimum": 0},
        "families": {"type": "array", "items": {"type": "string"}},
        "note": {"type": "string"},
        "feature_screening": {
          "type": "object",
          "additionalProperties": false,
          "required": ["condition_number", "exclusions", "final_vif", "investigations", "kept"],
          "properties": {
            "condition_number": {"type": "number"},
            "exclusions": {"type": "array", "items": {"type": "object"}},
            "final_vif": {"type": "array", "items": {"type": "object"}},
            "investigations": {"type": "array", "items": {"type": "object"}},
            "kept": {"type": "array", "items": {"type": "string"}}
          }
        },
        "model": {
          "type": "object",
          "additionalProperties": false,
          "required": ["features", "log_likelihood", "null_log_likelihood", "standardized", "type"],
          "properties": {
            "features": {"type": "array", "items": {"type": "string"}},
            "log_likelihood": {"type": "number"},
            "null_log_likelihood": {"type": "number"},
            "standardized": {"type": "boolean"},
            "type": {"type": "string"}
          }
        },
        "specification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["breusch_pagan", "cooks_distance", "durbin_watson", "hosmer_lemeshow", "jarque_bera", "link_test", "pseudo_r2", "reset_test"],
          "properties": {
            "breusch_pagan": {"type": "object"},
            "cooks_distance": {"type": "object"},
            "durbin_watson": {"type": "object"},
            "hosmer_lemeshow": {"type": "object"},
            "jarque_bera": {"type": "object"},
            "link_test": {"type": "object"},
            "pseudo_r2": {
              "type": "object",
              "additionalProperties": false,
              "required": ["mcfadden", "tjur"],
              "properties": {
                "mcfadden": {"type": "number"},
                "tjur": {"type": "number"}
              }
            },
            "reset_test": {"type": "object"}
          }
        },
        "hypotheses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "statement", "null", "test", "direction", "alpha", "statistic", "p_value", "q_value", "estimate", "ci95", "effect_size", "null_decision"],
            "properties": {
              "id": {"type": "string"},
              "statement": {"type": "string"},
              "null": {"type": "string"},
              "test": {"type": "string"},
              "direction": {"type": "string"},
              "alpha": {"type": "number"},
              "statistic": {"type": ["number", "null"]},
              "p_value": {"type": "number", "minimum": 0, "maximum": 1},
              "q_value": {"type": ["number", "null"]},
              "estimate": {"type": ["number", "null"]},
              "ci95": {"type": "array", "items": {"type": ["number", "null"]}, "minItems": 2, "maxItems": 2},
              "effect_size": {
                "type": "object",
                "required": ["name", "value"],
                "properties": {
                  "name": {"type": "string"},
                  "value": {"type": ["number", "null"]}
                }
              },
              "n_ai": {"type": "integer", "minimum": 0},
              "n_human": {"type": "integer", "minimum": 0},
              "df": {"type": "integer", "minimum": 1},
              "permutations": {"type": "integer", "minimum": 1},
              "n_documents": {"type": "integer", "minimum": 0},
              "n_segments": {"type": "integer", "minimum": 0},
              "bootstrap_resample_size": {"type": "array", "items": {"type": "integer"}, "minItems": 2, "maxItems": 2},
              "skipped": {"type": "string"},
              "null_decision": {"type": "string", "enum": ["rejected", "not rejected"]}
            }
          }
        }
      }
    }
  }
}
