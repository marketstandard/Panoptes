{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://panoptes.dev/schemas/neural-pilot-card.schema.json",
  "title": "Panoptes Neural Architecture Pilot Selection Card",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "created_utc",
    "seed",
    "phase",
    "data_firewall",
    "cohort",
    "environment",
    "config",
    "window_conditions",
    "selection_rule",
    "runs",
    "winner",
    "limitations",
    "artifact_sha256"
  ],
  "properties": {
    "schema": {"const": "panoptes-neural-pilot-v1"},
    "created_utc": {"type": "string"},
    "seed": {"type": "integer"},
    "phase": {"type": "string"},
    "data_firewall": {"type": "string"},
    "cohort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset", "train_rows_selected", "dev_rows_selected", "train_subsample", "dev_subsample"],
      "properties": {
        "dataset": {"type": "string"},
        "train_rows_selected": {"type": "integer"},
        "dev_rows_selected": {"type": "integer"},
        "train_subsample": {"type": "object"},
        "dev_subsample": {"type": "object"}
      }
    },
    "environment": {"type": "object"},
    "config": {"type": "object"},
    "window_conditions": {"type": "object"},
    "selection_rule": {"type": "string"},
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage", "encoder", "objective", "aggregation", "window", "status"],
        "properties": {
          "stage": {"type": "string"},
          "encoder": {"type": "string"},
          "objective": {"enum": ["erm", "group_balanced", "group_dro"]},
          "aggregation": {"enum": ["overlap_corrected_logit_mean", "hierarchical_summary_head"]},
          "window": {
            "type": "object",
            "additionalProperties": false,
            "required": ["max_length", "overlap"],
            "properties": {
              "max_length": {"type": "integer"},
              "overlap": {"type": "integer"}
            }
          },
          "status": {"enum": ["ok", "failed"]},
          "dev": {"type": "object"},
          "latency": {"type": "object"},
          "best_epoch": {"type": ["integer", "null"]},
          "summary_head": {"type": "string"},
          "error": {"type": "string"}
        }
      }
    },
    "winner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["encoder", "objective", "aggregation", "window", "dev", "latency"],
      "properties": {
        "encoder": {"type": "string"},
        "objective": {"enum": ["erm", "group_balanced", "group_dro"]},
        "aggregation": {"enum": ["overlap_corrected_logit_mean", "hierarchical_summary_head"]},
        "window": {"type": "object"},
        "dev": {"type": "object"},
        "latency": {"type": ["object", "null"]}
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}},
    "artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
