{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://panoptes.dev/schemas/defactify-summary.schema.json",
  "title": "Panoptes Defactify Summary",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "dataset", "created_utc", "n_records", "n_human", "n_ai", "families", "splits", "hygiene", "group_reconstruction", "leakage_audit", "citation", "artifact_sha256"],
  "properties": {
    "schema": {"const": "panoptes-defactify-summary-v1"},
    "dataset": {"type": "string"},
    "created_utc": {"type": "string"},
    "n_records": {"type": "integer", "minimum": 0},
    "n_human": {"type": "integer", "minimum": 0},
    "n_ai": {"type": "integer", "minimum": 0},
    "families": {"type": "object", "additionalProperties": {"type": "integer"}},
    "splits": {"type": "object", "additionalProperties": {"type": "integer"}},
    "hygiene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dropped_error_artifacts", "dropped_exact_duplicates", "dropped_under_50_tokens", "rows_raw"],
      "properties": {
        "dropped_error_artifacts": {"type": "integer", "minimum": 0},
        "dropped_exact_duplicates": {"type": "integer", "minimum": 0},
        "dropped_under_50_tokens": {"type": "integer", "minimum": 0},
        "rows_raw": {"type": "integer", "minimum": 0}
      }
    },
    "group_reconstruction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["threshold", "n_groups", "group_size_mean", "group_size_max", "singletons"],
      "properties": {
        "threshold": {"type": "number"},
        "n_groups": {"type": "integer", "minimum": 0},
        "group_size_mean": {"type": "number"},
        "group_size_max": {"type": "integer", "minimum": 1},
        "singletons": {"type": "integer", "minimum": 0}
      }
    },
    "leakage_audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["official_test_rows", "official_test_rows_with_train_near_duplicate", "official_split_story_leakage_rate"],
      "properties": {
        "official_test_rows": {"type": "integer", "minimum": 0},
        "official_test_rows_with_train_near_duplicate": {"type": "integer", "minimum": 0},
        "official_split_story_leakage_rate": {"type": "number"}
      }
    },
    "citation": {"type": "string"},
    "artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
