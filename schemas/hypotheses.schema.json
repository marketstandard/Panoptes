{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://panoptes.dev/schemas/hypotheses.schema.json",
  "title": "Panoptes Pre-registered Hypotheses",
  "description": "H1–H6 stylometry battery. Primary claims RQ1–RQ4 live in the research protocol.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "registered_utc", "alpha", "multiple_testing", "hypotheses", "artifact_sha256"],
  "properties": {
    "schema": {"const": "panoptes-hypotheses-v1"},
    "registered_utc": {"type": "string"},
    "alpha": {"type": "number"},
    "multiple_testing": {"type": "string"},
    "note": {"type": "string"},
    "hypotheses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "null", "test", "alpha", "direction"],
        "properties": {
          "id": {"type": "string"},
          "statement": {"type": "string"},
          "null": {"type": "string"},
          "test": {"type": "string"},
          "alpha": {"type": "number"},
          "direction": {"type": "string"},
          "variables": {"type": "object"}
        }
      }
    },
    "artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
